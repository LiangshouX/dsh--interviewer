{
  "name": "dsh-realtime-interview",
  "version": "0.9.0",
  "description": "DSH 实时模拟面试插件：简历 + JD → 有准备的面试 → 逐轮追问 → 实时摄像与语音 → 事后分析报告。Real-time mock-interview plugin for DeepSeek Harness: live ASR/TTS, camera, and a post-interview report — everything stays on your machine.",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.3 <0.3.0-0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LiangshouX/dsh-realtime-interview.git",
    "directory": "."
  },
  "homepage": "https://github.com/LiangshouX/dsh-realtime-interview#readme",
  "bugs": {
    "url": "https://github.com/LiangshouX/dsh-realtime-interview/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "author": {
    "name": "LiangshouX",
    "url": "https://github.com/LiangshouX"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "src/host",
    "build/skills",
    "assets",
    "!assets/*/*/source/**",
    "tests"
  ],
  "scripts": {
    "prepublishOnly": "node scripts/build.mjs",
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "pack": "node scripts/pack.mjs",
    "install-desktop": "node scripts/install-desktop.mjs",
    "test": "node --test tests/*.test.js",
    "client-smoke": "node scripts/client-smoke.mjs",
    "check-camera-release": "node dev/check-camera-release.mjs",
    "fix-keys": "node scripts/fix-keys.mjs"
  },
  "devDependencies": {
    "acorn": "^8.19.0",
    "playwright-core": "^1.65.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-test-renderer": "^18.3.1"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "interview",
    "mock-interview",
    "job-interview",
    "realtime",
    "voice",
    "asr",
    "tts",
    "camera",
    "career",
    "chinese"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-modules"
      ]
    }
  }
}
